{
  "name": "DSH-library",
  "version": "0.5.7",
  "description": "DSH Library（本地资料库）：把文件放进本机一处，之后每个对话都能直接检索、读取、下载；带侧边栏面板、文件夹分类、备注、最近访问与工作生成文件",
  "author": "Fucaplos",
  "contributors": [
    "gch3212 (0.5 的侧边栏面板 / 文件夹 / 备注 / 工作文件)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gch3212/DSH-library.git"
  },
  "homepage": "https://github.com/gch3212/DSH-library#readme",
  "bugs": {
    "url": "https://github.com/gch3212/DSH-library/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./lib/*": "./lib/*",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "icon": "assets/icon-180.png",
  "files": [
    "lib",
    "assets",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:client": "node scripts/splice-panel.mjs",
    "install:tarball": "pwsh -File scripts/install-tarball.ps1",
    "check": "node scripts/splice-panel.mjs --check",
    "test": "node test/run-all.mjs",
    "test:api": "node test/api.e2e.mjs",
    "test:tools": "node test/tools.e2e.mjs",
    "test:panel": "node test/panel.smoke.mjs",
    "inspect:live": "node test/check-live.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "knowledge-base",
    "local-library",
    "rag",
    "file-manager",
    "sidebar-panel",
    "folders",
    "dsh-library"
  ],
  "license": "MIT"
}
